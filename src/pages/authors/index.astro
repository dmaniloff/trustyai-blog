---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TeamGrid from '../../components/TeamGrid.astro';

const authors = await getCollection('authors');
---

<html lang="en">
	<head>
		<BaseHead title="Authors" description="Meet the team" />
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h1>Our Authors</h1>
				<p>Meet the authors behind our blog posts.</p>
				<TeamGrid authors={authors} />
			</section>
		</main>
		<Footer />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			section {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
			}
			h1 {
				font-size: 2.5rem;
				margin-bottom: 0.5rem;
			}
		</style>
	</body>
</html>
