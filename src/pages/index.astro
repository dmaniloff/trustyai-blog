---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TeamGrid from '../components/TeamGrid.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const authors = await getCollection('authors');
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
).slice(0, 2);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			body {
				background: #fafafa;
			}
			main {
				max-width: 960px;
				margin: 0 auto;
				padding: 3rem 2rem;
			}
			.hero-section {
				text-align: center;
				margin-bottom: 4rem;
			}
			.logo {
				width: 400px;
				height: auto;
				margin-bottom: 1.5rem;
			}
			h1 {
				font-size: 2.5rem;
				margin: 0 0 1rem 0;
				color: rgb(var(--black));
				font-weight: 600;
			}
			.tagline {
				font-size: 1.25rem;
				color: #6b7280;
				line-height: 1.6;
				font-weight: 400;
				margin: 0;
				max-width: 600px;
				margin: 0 auto;
			}
			.blog-section, .team-section {
				margin-top: 4rem;
			}
			.blog-section h2, .team-section h2 {
				font-size: 2rem;
				text-align: center;
				margin-bottom: 2rem;
				color: rgb(var(--black));
			}
			.blog-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				gap: 2rem;
				margin: 0 auto;
				max-width: 800px;
			}
			.blog-card {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				padding: 1.5rem;
				transition: box-shadow 0.2s ease;
				background: white;
			}
			.blog-card:hover {
				box-shadow: var(--box-shadow);
			}
			.blog-link {
				text-decoration: none;
				color: inherit;
				display: block;
			}
			.blog-card h3 {
				margin: 0 0 0.5rem 0;
				color: rgb(var(--black));
				font-size: 1.25rem;
			}
			.blog-description {
				margin: 0 0 1rem 0;
				color: rgb(var(--gray-dark));
				line-height: 1.5;
			}
			.blog-date {
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			@media (max-width: 720px) {
				main {
					padding: 2rem 1rem;
				}
				.logo {
					width: 150px;
				}
				h1 {
					font-size: 2rem;
				}
				.tagline {
					font-size: 1.1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero-section">
				<img src="/magentalab.png" alt="Magenta Lab" class="logo" />
				<h1>Magenta Lab</h1>
				<p class="tagline">
					Welcome! We are a research group at the intersection of AI safety, security, and trustworthiness. 
					We aim to make AI safety both practical and accessible. 
					Practical in the sense that you can implement it today, 
					and accessible in the sense that our tools are open source and free from vendor lock-in.
				</p>
			</section>

			<section class="blog-section">
				<h2>Latest Posts</h2>
				<div class="blog-grid">
					{posts.map((post) => (
						<article class="blog-card">
							<a href={`/blog/${post.slug}/`} class="blog-link">
								<h3>{post.data.title}</h3>
								<p class="blog-description">{post.data.description}</p>
								<time class="blog-date">{post.data.pubDate.toLocaleDateString()}</time>
							</a>
						</article>
					))}
				</div>
			</section>

			<section class="team-section">
				<h2>Our Team</h2>
				<TeamGrid authors={authors} />
			</section>
		</main>
		<Footer />
	</body>
</html>
