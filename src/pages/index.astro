---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import { getBaseUrl } from '../utils/urls';

const authors = await getCollection('authors');
const baseUrl = getBaseUrl();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			body {
				background: #fafafa;
			}
			main {
				max-width: 960px;
				margin: 0 auto;
				padding: 3rem 2rem;
			}
			.hero-section {
				text-align: center;
				margin-bottom: 4rem;
			}
			.logo {
				width: 200px;
				height: auto;
				margin-bottom: 1.5rem;
			}
			h1 {
				font-size: 2.5rem;
				margin: 0 0 1rem 0;
				color: rgb(var(--black));
				font-weight: 600;
			}
			.tagline {
				font-size: 1.25rem;
				color: #6b7280;
				line-height: 1.6;
				font-weight: 400;
				margin: 0;
				max-width: 600px;
				margin: 0 auto;
			}
			.team-section {
				margin-top: 4rem;
			}
			.team-section h2 {
				font-size: 2rem;
				text-align: center;
				margin-bottom: 2rem;
				color: rgb(var(--black));
			}
			.team-grid {
				list-style: none;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
				gap: 2rem;
				margin: 0;
			}
			.team-member {
				display: flex;
				justify-content: center;
			}
			.member-link {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				padding: 1.5rem;
				border-radius: 12px;
				background: white;
				border: 1px solid color-mix(in srgb, var(--accent) 10%, transparent);
				transition: all 0.3s ease;
				text-decoration: none;
				color: inherit;
				width: 100%;
				max-width: 200px;
			}
			.member-link:hover {
				transform: translateY(-4px);
				box-shadow: 0 8px 25px color-mix(in srgb, var(--accent) 15%, transparent);
				border-color: color-mix(in srgb, var(--accent) 90%, transparent);
				text-decoration: none;
				color: inherit;
			}
			.member-avatar {
				width: 100px;
				height: 100px;
				border-radius: 50%;
				overflow: hidden;
				margin-bottom: 1rem;
				border: 3px solid color-mix(in srgb, var(--accent) 50%, transparent);
			}
			.member-avatar img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			.member-name {
				font-size: 1.1rem;
				font-weight: 600;
				margin: 0;
				color: rgb(var(--black));
			}
			@media (max-width: 720px) {
				main {
					padding: 2rem 1rem;
				}
				.logo {
					width: 150px;
				}
				h1 {
					font-size: 2rem;
				}
				.tagline {
					font-size: 1.1rem;
				}
				.team-grid {
					grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
					gap: 1.5rem;
				}
				.member-link {
					padding: 1rem;
				}
				.member-avatar {
					width: 80px;
					height: 80px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero-section">
				<img src="/magentalab.png" alt="Magenta Lab" class="logo" />
				<h1>Magenta Lab</h1>
				<p class="tagline">
					A research group at the intersection of AI safety, security, and trustworthiness.
				</p>
			</section>

			<section class="team-section">
				<ul class="team-grid">
					{
						authors.map((author) => (
							<li class="team-member">
								<a href={`${baseUrl}/authors/${author.id}/`} class="member-link">
									{author.data.avatar && (
										<div class="member-avatar">
											<img src={author.data.avatar} alt={author.data.name} />
										</div>
									)}
									<h3 class="member-name">{author.data.name}</h3>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
