---
import SocialLinks from './SocialLinks.astro';
import { getBaseUrl } from '../utils/urls';

interface Props {
	authors: any[];
}

const { authors } = Astro.props;
const baseUrl = getBaseUrl();
---

<ul class="authors-grid">
	{
		authors.map((author) => (
			<li class="author-card">
				<div class="author-content">
					<a href={`${baseUrl}/authors/${author.id}/`} class="author-link">
						{author.data.avatar && (
							<img
								src={author.data.avatar.startsWith('/') ? `${baseUrl}${author.data.avatar}` : author.data.avatar}
								alt={author.data.name}
								class="author-avatar"
							/>
						)}
						<h4>{author.data.name}</h4>
						{author.data.bio && <p>{author.data.bio}</p>}
					</a>
					<SocialLinks author={author} size="small" />
				</div>
			</li>
		))
	}
</ul>

<style>
	.authors-grid {
		list-style: none;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
		margin: 2rem 0;
	}
	.author-card {
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		padding: 1.5rem;
		transition: box-shadow 0.2s ease;
	}
	.author-card:hover {
		box-shadow: var(--box-shadow);
	}
	.author-content {
		display: flex;
		flex-direction: column;
		height: 100%;
	}
	.author-link {
		text-decoration: none;
		color: inherit;
		display: block;
		flex: 1;
	}
	.author-avatar {
		width: 80px;
		height: 80px;
		border-radius: 50%;
		object-fit: cover;
		margin-bottom: 1rem;
	}
	.author-card h4 {
		margin: 0 0 0.5rem 0;
		color: rgb(var(--black));
	}
	.author-card p {
		margin: 0;
		color: rgb(var(--gray-dark));
		line-height: 1.5;
	}
</style> 